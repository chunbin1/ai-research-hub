# 生产环境配置(与本地 .env 分开)。拷成 .env.prod 后填真实值;.env.prod 已 gitignore。
# --- 智谱 ---
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.7-flash,glm-4.5-flash
ZHIPU_EMBEDDING_MODEL=embedding-3
# --- 认证:必须 false(生产严禁开 AUTH_DISABLED)---
AUTH_DISABLED=false
# 在 GitHub 注册 OAuth App 后填(见 docs/DEPLOY.md);回调填 https://your-domain.example/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 在 Google Cloud 建 Web 应用 OAuth 客户端后填(见 docs/DEPLOY.md)
# 回调填 https://your-domain.example/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 你的公网域名(无尾斜杠)
APP_URL=https://your-domain.example
# 会话签名密钥:openssl rand -hex 32 生成后填
COOKIE_SECRET=
# --- 限次 ---
MESSAGE_LIMIT=10
GLOBAL_LIMIT=1000

# 用户自带模型(BYOK):加密用户 API key 的主密钥
# 生成:openssl rand -hex 32
# 不配则「自带模型」功能关闭,站点其余部分正常运行
LLM_KEY_SECRET=

# 实盘持仓上传密钥(可选)。openssl rand -hex 32
# 不配则 PUT /api/holdings 返回 503。只在 HTTPS 上使用,不要打进日志。
HOLDINGS_API_KEY=

# 大佬持仓（SEC 13F）。不配联系方式则跳过拉取。WHALES=off 关闭整块。
# SEC_USER_AGENT=ai-research-hub whales-13f you@example.com
# WHALES_CONTACT_EMAIL=
# WHALES=off
