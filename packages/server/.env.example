ZHIPU_API_KEY=
# 站点默认模型。管理员在 /admin 改过之后,库里的值优先,这里的配置不再生效
# (点「恢复为 .env 默认」可以退回来)。支持逗号分隔的降级链,前一个报 429/配额错误时自动切下一个
ZHIPU_MODEL=glm-4.7-flash,glm-4.5-flash
ZHIPU_EMBEDDING_MODEL=embedding-3
PORT=3001
CHROMA_URL=http://localhost:8000
# 检索调参(都有合理默认值,一般不用动):
# RAG_MAX_K=5        最终交给模型的块数
# RAG_POOL_SIZE=20   每一路融合前各自召回多少条
# RAG_RRF_K=60       RRF 的 k,越大越偏袒两路共识
# LOG_RETRIEVAL=1    打印每次检索的召回数

# 认证(GitHub / Google OAuth);默认关闭跳过登录,避免直接复制成 .env 时不安全;
# 本地开发可设 AUTH_DISABLED=true 跳过登录(所有人=管理员)
AUTH_DISABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 在 Google Cloud 建 Web 应用 OAuth 客户端后填(见 docs/DEPLOY.md)
# 回调填 http://localhost:5173/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:5173
COOKIE_SECRET=
# 限次
MESSAGE_LIMIT=10
GLOBAL_LIMIT=1000

# 用户自带模型(BYOK):加密用户 API key 的主密钥
# 生成:openssl rand -hex 32
# 不配则「自带模型」功能关闭,站点其余部分正常运行
LLM_KEY_SECRET=

# 实盘持仓上传密钥。第三方全量覆盖 PUT /api/holdings,任选一种 Header:
#   Authorization: Bearer <key>
#   X-Holdings-Key: <key>
# 生成:openssl rand -hex 32
# 不配或只留空白则上传接口 503,已有快照仍可公开读取;没有快照时导航和 /holdings 都不出现。
# 只在 HTTPS 上使用。不要把密钥放进查询串,也不要打进访问日志、错误日志或请求体日志。
HOLDINGS_API_KEY=
