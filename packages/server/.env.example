ZHIPU_API_KEY=
# 站点默认模型。管理员在 /admin 改过之后,库里的值优先,这里的配置不再生效
# (点「恢复为 .env 默认」可以退回来)。支持逗号分隔的降级链:glm-4.7,glm-4-flash
ZHIPU_MODEL=glm-4.7
ZHIPU_EMBEDDING_MODEL=embedding-3
PORT=3001
CHROMA_URL=http://localhost:8000
# 研报章节长、问题宽,单篇检索返回块数上调(默认 5 偏紧,关键节常排到 6~9 位)
RAG_MAX_K=10
# cosine 距离阈值(默认 0.7);# LOG_RETRIEVAL=1 打印每次检索的候选距离
# RAG_DISTANCE_THRESHOLD=0.7
# LOG_RETRIEVAL=1

# 认证(GitHub OAuth);默认关闭跳过登录,避免直接复制成 .env 时不安全;
# 本地开发可设 AUTH_DISABLED=true 跳过登录(所有人=管理员)
AUTH_DISABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_URL=http://localhost:5173
COOKIE_SECRET=
# 限次
MESSAGE_LIMIT=10
GLOBAL_LIMIT=1000

# 用户自带模型(BYOK):加密用户 API key 的主密钥
# 生成:openssl rand -hex 32
# 不配则「自带模型」功能关闭,站点其余部分正常运行
LLM_KEY_SECRET=
