{
  "name": "ai-research-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:server": "pnpm --filter @arh/server dev",
    "dev:client": "pnpm --filter @arh/client dev",
    "build:client": "pnpm --filter @arh/client build",
    "typecheck": "pnpm --filter @arh/server typecheck && pnpm --filter @arh/client exec tsc --noEmit",
    "test": "pnpm --filter @arh/server test && pnpm --filter @arh/client test",
    "reset:dev": "pnpm --filter @arh/server reset:dev",
    "import:raw": "pnpm --filter @arh/server import:raw",
    "reindex": "pnpm --filter @arh/server reindex",
    "eval:retrieval": "pnpm --filter @arh/server eval:retrieval"
  }
}
